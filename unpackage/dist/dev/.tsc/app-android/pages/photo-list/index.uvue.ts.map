<template>
	<view class="page">
		<scroll-view scroll-y="true" class="scroll-view">
			<view v-if="photoRecords.length == 0" class="empty-box">
				<text class="empty-title">还没有识别抓拍照片</text>
				<text class="empty-desc">开始 1:N 人脸识别后，抓拍照片会自动保存在这里。</text>
			</view>
			<view v-for="item in photoRecords" :key="item.id" class="photo-card">
				<image class="photo-image" :src="item.imageBase64" mode="widthFix"></image>
				<view class="photo-meta">
					<text class="photo-status">{{ item.matched ? '匹配成功' : '未匹配到结果' }}</text>
					<text class="photo-time">{{ formatTime(item.createdAt) }}</text>
					<text class="photo-name">{{ getFaceNameText(item) }}</text>
					<text class="photo-score">{{ getFaceScoreText(item) }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts">
	import { getAllFacePhotoRecords, type FacePhotoRecord } from './photoStore.uts'

	export default {
		data() {
			return {
				photoRecords: [] as FacePhotoRecord[],
			}
		},
		onShow() {
			this.loadPhotoRecords()
		},
		methods: {
			loadPhotoRecords() {
				this.photoRecords = getAllFacePhotoRecords()
			},
			formatTime(timestamp: number): string {
				const date = new Date(timestamp)
				const year = date.getFullYear()
				const month = `${date.getMonth() + 1}`.padStart(2, '0')
				const day = `${date.getDate()}`.padStart(2, '0')
				const hour = `${date.getHours()}`.padStart(2, '0')
				const minute = `${date.getMinutes()}`.padStart(2, '0')
				const second = `${date.getSeconds()}`.padStart(2, '0')
				return `${year}-${month}-${day} ${hour}:${minute}:${second}`
			},
			getFaceNameText(item: FacePhotoRecord): string {
				if (item.faceName.length > 0) {
					return '\u59d3\u540d\uff1a' + item.faceName
				}
				return '\u59d3\u540d\uff1a\u65e0'
			},
			getFaceScoreText(item: FacePhotoRecord): string {
				if (item.matched) {
					return '\u5206\u6570\uff1a' + item.faceScore
				}
				return '\u5206\u6570\uff1a\u65e0'
			},
		},
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #f5f7fb;
	}

	.scroll-view {
		height: 100vh;
		padding: 24rpx;
		box-sizing: border-box;
	}

	.empty-box {
		margin-top: 160rpx;
		padding: 48rpx 36rpx;
		border-radius: 24rpx;
		background: linear-gradient(135deg, #ffffff 0%, #eef3ff 100%);
		box-shadow: 0 12rpx 40rpx rgba(40, 68, 120, 0.08);
	}

	.empty-title {
		display: block;
		font-size: 34rpx;
		font-weight: 600;
		color: #1f2a44;
		margin-bottom: 16rpx;
	}

	.empty-desc {
		display: block;
		font-size: 28rpx;
		line-height: 42rpx;
		color: #60708f;
	}

	.photo-card {
		margin-bottom: 24rpx;
		border-radius: 24rpx;
		overflow: hidden;
		background-color: #ffffff;
		box-shadow: 0 12rpx 36rpx rgba(27, 39, 79, 0.08);
	}

	.photo-image {
		width: 100%;
		background-color: #dfe6f5;
	}

	.photo-meta {
		padding: 24rpx;
	}

	.photo-status,
	.photo-time,
	.photo-name,
	.photo-score {
		display: block;
		font-size: 28rpx;
		line-height: 42rpx;
		color: #33415c;
	}

	.photo-status {
		font-size: 30rpx;
		font-weight: 600;
		color: #0f6b57;
		margin-bottom: 10rpx;
	}
</style>
